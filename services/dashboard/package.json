{
    "name": "safestream-dashboard",
    "private": true,
    "version": "0.4.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview --host 0.0.0.0 --port 8080",
        "type-check": "tsc -b --noEmit",
        "format": "prettier --write .",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.28.0",
        "recharts": "^2.13.3"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.0.1",
        "@testing-library/user-event": "^14.5.2",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^4.3.3",
        "autoprefixer": "^10.4.20",
        "jsdom": "^25.0.1",
        "postcss": "^8.4.49",
        "prettier": "^3.8.3",
        "tailwindcss": "^3.4.14",
        "typescript": "^5.6.3",
        "vite": "^7.0.0",
        "vitest": "^4.1.5"
    }
}

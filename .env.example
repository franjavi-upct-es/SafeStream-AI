# .env.example
# Copy to `.env` and tweak as needed. Values shown are the defaults.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=safestream
POSTGRES_PASSWORD=safestream
POSTGRES_DB=safestream

# --- Producer ----------------------------------------------------------------
# Path inside the container. The bind mount exposes ./services/producer/data
# at /app/data, so put your dataset there and point this variable to it.
DATASET_PATH=/app/data/sample_comments.csv
EVENTS_PER_SECOND=10
LOOP_DATASET=true
LOG_LEVEL=INFO

# --- Inference: models -------------------------------------------------------
# Disable a modality entirely to skip model loading (faster startup).
ENABLE_TEXT=true
ENABLE_VISION=false
ENABLE_EMBEDDINGS=true

# Any HF text-classification model works. Defaults expose all 6 Jigsaw labels.
NLP_MODEL_NAME=unitary/toxic-bert
NLP_MAX_LENGTH=256

# Any HF image-classification model works.
CV_MODEL_NAME=Falconsai/nsfw_image_detection

# Any sentence-transformers model. EMBEDDING_DIM MUST match the model output;
# all-MiniLM-L6-v2 -> 384, paraphrase-multilingual-MiniLM-L12-v2 -> 384,
# all-mpnet-base-v2 -> 768.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Inference: vector store -------------------------------------------------
QDRANT_COLLECTION=safestream_sanctioned
# Comma-separated verdicts that trigger an upsert into Qdrant.
INDEX_VERDICTS=review,block

# --- Inference: verdict ------------------------------------------------------
# verdict = block  if max(scores) >= THRESHOLD_BLOCK
#         = review if max(scores) >= THRESHOLD_REVIEW
#         = safe   otherwise
THRESHOLD_REVIEW=0.4
THRESHOLD_BLOCK=0.8

# --- Inference: auth & rate limit --------------------------------------------
# Comma-separated allow-list. Leave empty to disable auth (local dev only).
API_KEYS=
RATE_LIMIT=100/minute

# --- Inference: worker -------------------------------------------------------
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
